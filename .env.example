APP_NAME=Chatroom
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: sqlite  |  Docker/Production: pgsql
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=chatroom
# DB_USERNAME=chatroom
# DB_PASSWORD=secret

# ── Broadcast / Cache / Queue / Session ───────────────────────────────────────
BROADCAST_CONNECTION=reverb
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@chatroom.test"
MAIL_FROM_NAME="${APP_NAME}"

# ── File Storage ──────────────────────────────────────────────────────────────
# Local dev: public  |  Production: spaces
FILESYSTEM_DISK=public

# DigitalOcean Spaces (S3-compatible)
# DO_SPACES_KEY=
# DO_SPACES_SECRET=
# DO_SPACES_REGION=nyc3
# DO_SPACES_BUCKET=chatroom-files
# DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# DO_SPACES_CDN_URL=https://chatroom-files.nyc3.cdn.digitaloceanspaces.com

# ── Search ────────────────────────────────────────────────────────────────────
SCOUT_DRIVER=database
# SCOUT_DRIVER=meilisearch
# MEILISEARCH_HOST=http://meilisearch:7700
# MEILISEARCH_KEY=

# ── Laravel Reverb (WebSockets) ───────────────────────────────────────────────
REVERB_APP_ID=chatroom
REVERB_APP_KEY=chatroom-key
REVERB_APP_SECRET=chatroom-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
